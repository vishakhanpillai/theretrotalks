PORT=5000
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p
TMDB_ACCESS_TOKEN=your_tmdb_read_access_token_here

# Admin Authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_admin_password_here

# Turso Cloud Database (Optional)
# If provided, connects to Turso Cloud (recommended for Render & production).
# If omitted or left blank, falls back to local SQLite database (backend/retro_talks.db).
TURSO_DATABASE_URL=libsql://your-database-name.aws-region.turso.io
TURSO_AUTH_TOKEN=your_turso_db_access_token_here
